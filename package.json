{
  "name": "@openagenet/oan-community-skill",
  "version": "1.1.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "description": "Community OAN registration, discovery, resource queries and local identity workflows.",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "tests",
    "references",
    "agents",
    "scripts",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "bin": {
    "oan-community": "./scripts/oan-community.mjs"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check:public": "npm run build && node scripts/check-public-services.mjs",
    "test": "node ./node_modules/tsx/dist/cli.mjs tests/oan-community-skill-tests.ts && node ./node_modules/tsx/dist/cli.mjs tests/community-current-contract-tests.ts && npm run build && node tests/community-cli-tests.mjs"
  },
  "dependencies": {
    "@openagenet/oan-sdk-ts": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "ed25519-signature-2020-context": "^1.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
